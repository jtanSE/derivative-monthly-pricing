# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Real month-end data must never be committed.
# Sanitized test fixtures are allowed explicitly below.
data/*/
!data/templates/

# No Excel files are ever committed — all broker/company data stays private.
# Tests read these from the local working tree; they are skipped when absent.
*.xls
*.xlsx

# Excel lock files
~$*.xls
~$*.xlsx

# Secrets & local config — never commit. API keys (ANTHROPIC_API_KEY, Bloomberg
# HAPI) and any Streamlit secrets are injected from the environment at deploy.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Local runtime state — the AI-onboarding token/cost meter's running totals.
# Per-machine, not source; regenerated on first use.
data/usage_totals.json

# Security write-ups are kept local, not published to the code remote.
SECURITY-*.md
